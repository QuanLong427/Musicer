# Musicer 环境变量配置
# 复制此文件为 .env.local 并填入你的配置

# ── AI 模型配置 ──────────────────────────────────────────
# OpenAI 兼容 API 的 base URL
OPENAI_BASE_URL=https://api.deepseek.com
# API 密钥（必填，放在 .env.local 中）
OPENAI_API_KEY=your-api-key-here
# 模型名称
MODEL_NAME=deepseek-chat

# ── 音频存储目录 ──────────────────────────────────────────
# 相对于项目根目录的路径，或绝对路径
MUSIC_DIR=Documents/bili

# ── 服务器配置 ──────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── 后端代理配置 ────────────────────────────────────────
# Python 后端地址（Next.js route.ts 代理转发用）
BACKEND_URL=http://localhost:8000

# ── Windows 编码设置 ──────────────────────────────────────
# 确保中文文件名正确读取（仅 Windows 需要）
PYTHONIOENCODING=utf-8
